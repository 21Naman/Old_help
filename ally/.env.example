# ---- Database ----
# Local: leave empty for SQLite (ally/ally.db). Production: your Neon connection string.
DATABASE_URL=

# ---- LLM (any LiteLLM model id) ----
LLM_MODEL=groq/llama-3.3-70b-versatile
LLM_FALLBACK_MODEL=gemini/gemini-2.5-flash
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional per-task override to save free quota, e.g.:
# LLM_MODEL_MORNING_CHECKIN=groq/llama-3.1-8b-instant

# ---- Voice ----
# Wispr Flow API key (speech-to-text). Empty = Groq Whisper (uses GROQ_API_KEY).
WISPR_API_KEY=
ALLY_TTS_VOICE_HI=hi-IN-SwaraNeural
ALLY_TTS_VOICE_EN=en-IN-NeerjaNeural

# ---- Sign-in & secrets ----
# Generate long random strings: python -c "import secrets;print(secrets.token_urlsafe(48))"
ALLY_JWT_SECRET=
ALLY_HMAC_SECRET=
# Shared key for sensor devices; optional per-device keys override it for that device.
ALLY_DEVICE_KEY=
ALLY_WATCH_DEVICE_KEY=
ALLY_PHONE_DEVICE_KEY=
ALLY_GUARD_DEVICE_KEY=
# Web Push: python scripts/gen_vapid.py
ALLY_VAPID_PUBLIC_KEY=
ALLY_VAPID_PRIVATE_KEY=
# Password for `python scripts/seed.py --users`
ALLY_SEED_PASSWORD=

# ---- Scheduler ----
# Local: 1 runs the per-minute sweep inside the API. Render: 0, and point cron-job.org at
# POST /ally/cron/sweep with header X-Cron-Secret: <ALLY_CRON_SECRET>.
ALLY_INPROC_SCHEDULER=1
ALLY_CRON_SECRET=

# ---- App ----
ALLY_PARENT_ID=amma
PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Dev-only: X-Dev-Member header identity + /ally/dev/sweep. Never set when deployed.
ALLY_DEV_TOOLS=1

# ---- Timings (shorten for demos) ----
ESCALATION_CONTACT_TIMEOUT=180
INVESTIGATION_WINDOW_MIN=15
WAKE_GRACE_MIN=15
