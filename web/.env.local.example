# Ally API (FastAPI). Local: uvicorn on 8002. Deployed: the Render web service URL.
NEXT_PUBLIC_SURAKSHA_API_URL=http://localhost:8002

# Sign-in: "jwt" shows the username/password login (POST /ally/auth/login).
# "dev" (or unset) shows the identity switcher; the API must run with ALLY_DEV_TOOLS=1.
NEXT_PUBLIC_AUTH=dev
